# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- Appointment booking ---
# See BOOKING_SETUP.md for the full picture. Both of these are PUBLIC
# (they end up in the browser bundle) — never put a real password or API
# key here. Real credentials live only in the proxy server's own env vars.

# VITE_BOOKING_API_URL: the public URL of YOUR proxy server (server/booking-proxy.js),
# not the hospital app's real, authenticated booking endpoint.
# Locally, once the proxy is running (npm run start:booking-proxy), this is:
VITE_BOOKING_API_URL="http://localhost:4000/api/public/appointments"

# VITE_DOCTOR_ID: this doctor's id in the hospital system, so bookings from
# this website land against the right doctor.
# Confirmed via DevTools: Dr. M. Sai Sashank's id is 3.
VITE_DOCTOR_ID="3"

# VITE_SLOTS_API_URL: the public URL of YOUR proxy's slot-availability route.
# Optional while developing — if unset, the page generates standard clinic-hours
# slots locally (all shown as available) so the UI still works end-to-end.
# Locally, once the proxy is running (npm run start:booking-proxy), this is:
VITE_SLOTS_API_URL="http://localhost:4000/api/public/slots"
