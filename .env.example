# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- Appointment booking ---
# See BOOKING_SETUP.md for the full picture. Both of these are PUBLIC
# (they end up in the browser bundle) — never put a real password or API
# key here. Real credentials live only in the proxy's own env vars
# (server/.env locally, or Vercel's Project -> Environment Variables).

# VITE_BOOKING_API_URL: where the browser sends a booking request.
# LOCAL DEV (standalone proxy via `npm run start:booking-proxy`):
VITE_BOOKING_API_URL="http://localhost:4000/api/public/appointments"
# PRODUCTION on Vercel (api/public/appointments.js deploys automatically
# alongside the site) — set this in Vercel's Environment Variables instead,
# as a path relative to the site's own domain, no need for a full URL:
#   VITE_BOOKING_API_URL=/api/public/appointments

# VITE_DOCTOR_ID: this doctor's id in the hospital system, so bookings from
# this website land against the right doctor.
# Confirmed via DevTools: Dr. M. Sai Sashank's id is 3.
VITE_DOCTOR_ID="3"

# VITE_SLOTS_API_URL: where the browser fetches slot availability from.
# Optional while developing — if unset, the page generates standard clinic-hours
# slots locally (all shown as available) so the UI still works end-to-end.
# LOCAL DEV:
VITE_SLOTS_API_URL="http://localhost:4000/api/public/slots"
# PRODUCTION on Vercel — set in Vercel's Environment Variables as:
#   VITE_SLOTS_API_URL=/api/public/slots

# VITE_PATIENTS_API_URL: where the browser looks up an existing patient once
# a full 10-digit mobile number is typed, to auto-fill name/DOB. Optional —
# if unset, auto-fill is simply skipped (the form still works fine without it).
# LOCAL DEV:
VITE_PATIENTS_API_URL="http://localhost:4000/api/public/patients"
# PRODUCTION on Vercel — set in Vercel's Environment Variables as:
#   VITE_PATIENTS_API_URL=/api/public/patients
